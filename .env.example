# Database Configuration
DATABASE_URL=postgresql://casepack:casepack_dev_password@localhost:5432/casepack
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Application Settings
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production
API_PREFIX=/api/v1

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# NextAuth Configuration
NEXTAUTH_SECRET=your-nextauth-secret-change-in-production-minimum-32-chars
NEXTAUTH_URL=http://localhost:3000

# Anthropic AI
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_BASIC=price_basic_pack_id
STRIPE_PRICE_STANDARD=price_standard_pack_id
STRIPE_PRICE_LARGE=price_large_pack_id

# Email Configuration (Optional - for magic links)
EMAIL_ENABLED=false
EMAIL_FROM=noreply@casepack.com
EMAIL_FROM_NAME=CasePack
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key

# File Storage
STORAGE_TYPE=local  # local or s3
UPLOAD_DIR=/tmp/casepack/uploads
STORAGE_DIR=/tmp/casepack/storage
MAX_UPLOAD_SIZE=524288000  # 500MB in bytes

# S3 Configuration (if STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_BUCKET_NAME=casepack-evidence
AWS_REGION=us-east-1
S3_ENDPOINT_URL=  # Leave empty for AWS, set for DO Spaces/Backblaze

# Security Settings
ENABLE_VIRUS_SCAN=false  # Set true if ClamAV installed
SIGNED_URL_EXPIRY=3600  # 1 hour in seconds
SESSION_EXPIRY=2592000  # 30 days in seconds
DATA_RETENTION_DAYS=30

# Processing Settings
OCR_LANGUAGE=eng  # Tesseract language code
OCR_DPI=300
MAX_FILES_PER_CASE=500
WORKER_TIMEOUT=3600  # 1 hour

# Monitoring
SENTRY_DSN=  # Optional Sentry DSN for error tracking
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Admin Configuration
ADMIN_EMAIL=admin@casepack.com
ADMIN_PASSWORD=change-this-secure-password

# Feature Flags
ENABLE_PAYMENTS=true
ENABLE_MAGIC_LINKS=false
ENABLE_ADMIN_CONSOLE=true
ENABLE_AUDIT_LOGS=true
