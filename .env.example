# Database Configuration
DATABASE_URL=postgresql://lifedocvault:lifedocvault_dev@localhost:5432/lifedocvault

# NextAuth Configuration
NEXTAUTH_SECRET=your-nextauth-secret-change-in-production-minimum-32-chars
NEXTAUTH_URL=http://localhost:3000

# Application Settings
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Life-Doc-Vault
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Anthropic AI
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (create these in Stripe Dashboard)
STRIPE_PRICE_FREE=price_free_tier_id
STRIPE_PRICE_PERSONAL=price_personal_tier_id
STRIPE_PRICE_PROFESSIONAL=price_professional_tier_id
STRIPE_PRICE_ENTERPRISE=price_enterprise_tier_id

# File Storage
STORAGE_TYPE=local  # local or s3
UPLOAD_DIR=./uploads
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE=52428800  # 50MB in bytes (Free tier)

# S3 Configuration (if STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_BUCKET_NAME=life-doc-vault-documents
AWS_REGION=us-east-1
S3_ENDPOINT_URL=  # Leave empty for AWS S3, or set for DigitalOcean Spaces/MinIO

# Redis Configuration (Optional - for caching and rate limiting)
REDIS_URL=redis://localhost:6379/0
UPSTASH_REDIS_REST_URL=  # For serverless Redis (Upstash)
UPSTASH_REDIS_REST_TOKEN=

# Security Settings
CSRF_SECRET=your-csrf-secret-change-in-production
RATE_LIMIT_ENABLED=true
RATE_LIMIT_UPLOAD=10  # requests per minute
RATE_LIMIT_API=60     # requests per minute
RATE_LIMIT_AUTH=5     # requests per minute

# OCR Settings
OCR_LANGUAGE=eng
OCR_DPI=300

# Tier Limits
FREE_TIER_STORAGE=104857600        # 100 MB
FREE_TIER_DOCUMENTS=10
PERSONAL_TIER_STORAGE=5368709120   # 5 GB
PERSONAL_TIER_DOCUMENTS=500
PROFESSIONAL_TIER_STORAGE=53687091200  # 50 GB
PROFESSIONAL_TIER_DOCUMENTS=-1     # Unlimited

# Data Retention (days)
DATA_RETENTION_DAYS=30

# Monitoring (Optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Logging
LOG_LEVEL=info  # error, warn, info, debug

# Feature Flags
ENABLE_PAYMENTS=true
ENABLE_OCR=true
ENABLE_AI_EXTRACTION=true
ENABLE_PACKET_GENERATION=true
ENABLE_ADMIN_PANEL=true
